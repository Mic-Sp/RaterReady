generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon pooled URL for application traffic; unpooled URL for Prisma migrations.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CANDIDATE
  ADMIN_REVIEWER
}

enum AccountStatus {
  ACTIVE
  DISABLED
  REVOKED
}

/// Separate purposes prevent an email-verification token from resetting a password.
enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum LearningLevel {
  FOUNDATIONS
  INTERMEDIATE
  ADVANCED
}

enum DiagnosticStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum Track {
  GENERALIST
  TECHNICAL_PREVIEW
}

enum Competency {
  G1
  G2
  G3
  G4
  G5
  G6
}

enum ScenarioBank {
  DIAGNOSTIC
  PRACTICE
  CAPSTONE
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum AssessmentMode {
  DIAGNOSTIC
  PRACTICE
  CAPSTONE
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADING
  PENDING_REVIEW
  FINALIZED
  EXPIRED
  ABANDONED
}

enum JudgeJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
  INVALID_OUTPUT
}

enum ReviewTriggerReason {
  ALPHA_SIGN_OFF
  JUDGE_DISAGREEMENT
  API_FAILURE
  TIMEOUT
  MALFORMED_JSON
  APPEAL
}

enum ReviewStatus {
  PENDING
  IN_REVIEW
  FINALIZED
  APPEALED
}

enum CredentialStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

/// A closed allowlist, rather than arbitrary public JSON, supports consent-first sharing.
enum CredentialPublicField {
  DISPLAY_NAME
  TRACK
  ISSUED_AT
  COMPETENCIES
}

enum OpportunityLinkType {
  PUBLIC_INFORMATION
  PUBLIC_APPLICATION
  CAREERS_PAGE
  PERSONAL_REFERRAL
}

enum AppealStatus {
  OPEN
  RESOLVED
}

enum AppealDisposition {
  UPHELD
  ADJUSTED
}

/// Stage A cannot represent an employer partnership.
enum PartnershipStatus {
  NO_FORMAL_PARTNERSHIP
}

model User {
  id                           String            @id @default(cuid())
  /// Server-generated identifier for live registration; reserved demo codes remain seed-only.
  accountCode                  String            @unique
  name                         String
  role                         Role
  /// Nullable only for migrated/unprovisioned accounts; a missing hash can never authenticate.
  passwordHash                 String?
  accountStatus                AccountStatus     @default(ACTIVE)
  /// Bump to revoke all sessions. A migration trigger also bumps on password/status/role changes.
  sessionVersion               Int               @default(0)
  /// Account identity only; scenario/attempt fixture markers remain independent.
  isSyntheticFixture           Boolean           @default(false)
  demoLabel                    String?
  /// Optional for seeded demos; live email addresses are normalized before persistence.
  email                        String?           @unique
  /// NULL means unverified; demo pre-verification is not real email delivery or consent.
  emailVerifiedAt              DateTime?         @db.Timestamptz(3)
  closedAlphaConsentAcceptedAt DateTime?         @db.Timestamptz(3)
  closedAlphaConsentVersion    String?
  createdAt                    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime          @updatedAt @db.Timestamptz(3)
  candidateProfile             CandidateProfile?
  ownedReviews                 ReviewCase[]      @relation("ReviewOwner")
  auditEvents                  AuditEvent[]
  authTokens                   AuthToken[]
}

/// Only SHA-256 digests of 256-bit random secrets are persisted. Never store or log raw tokens.
/// SQL checks/trigger preserve immutable identity, bounded lifetime and irreversible consumption.
model AuthToken {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  purpose        AuthTokenPurpose
  tokenHash      String           @unique @db.Char(64)
  /// Security snapshot invalidates outstanding tokens on account/password/email changes.
  sessionVersion Int
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime         @db.Timestamptz(3)
  consumedAt     DateTime?        @db.Timestamptz(3)

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// Shared across server instances; keyed HMACs contain no raw emails, IPs or submitted credentials.
model RegistrationRateLimit {
  keyHash         String   @id @db.Char(64)
  attemptCount    Int
  windowStartedAt DateTime @db.Timestamptz(3)
  expiresAt       DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

model CandidateProfile {
  userId                String              @id
  user                  User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  selectedLevel         LearningLevel       @default(FOUNDATIONS)
  track                 Track               @default(GENERALIST)
  /// Optional, untimed and non-certifying; skipping never blocks level selection.
  diagnosticStatus      DiagnosticStatus    @default(NOT_STARTED)
  /// Records an explicit level choice; no diagnostic or beginner prerequisite is required.
  onboardingCompletedAt DateTime?           @db.Timestamptz(3)
  /// Minimal learning telemetry: no URLs, visit history, device data or identifiers beyond this profile.
  firstLessonOpenedAt    DateTime?           @db.Timestamptz(3)
  lastActiveAt           DateTime?           @db.Timestamptz(3)
  /// The only accommodation datum: finite numeric multiplier >= 1, with no reason collected.
  timeMultiplier        Float               @default(1)
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(3)
  moduleProgress        ModuleProgress[]
  attempts              AssessmentAttempt[]
  exposures             ScenarioExposure[]
  diagnostic            DiagnosticSession?
  practiceDrafts        PracticeDraft[]
  practiceProgress      PracticeProgress[]
}

/// Advisory-only selections are isolated from AssessmentAttempt and Credential by design.
/// No timer, pass/fail score, written-prose grading, or sensitive disclosure fields exist here.
model DiagnosticSession {
  candidateId        String           @id
  candidate          CandidateProfile @relation(fields: [candidateId], references: [userId], onDelete: Restrict)
  version            Int              @default(1)
  status             DiagnosticStatus @default(IN_PROGRESS)
  answersJson        Json             @default("{}")
  feedbackJson       Json?
  suggestedLevel     LearningLevel?
  revision           Int              @default(0)
  isSyntheticFixture Boolean          @default(true)
  demoLabel          String           @default("DEMO - SYNTHETIC")
  startedAt          DateTime         @default(now()) @db.Timestamptz(3)
  completedAt        DateTime?        @db.Timestamptz(3)
}

/// Authored non-certifying instruction; fictional worked excerpts are labeled inside contentJson.
/// The composite key retains historical lesson slots, independently of practice competency names.
model CurriculumLesson {
  level       LearningLevel
  competency  Competency
  contentJson Json

  @@id([level, competency])
}

/// Self-marked reading, never practice coverage or mastery. Independent of selectedLevel.
/// Existing historical slot keys survive curriculum expansion and level switches unchanged.
model ModuleProgress {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [userId], onDelete: Restrict)
  competency  Competency
  level       LearningLevel
  completedAt DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([candidateId, competency, level])
}

/// One resumable draft per learner/scenario. Temporary research notes are never stored here.
model PracticeDraft {
  candidateId          String
  candidate            CandidateProfile @relation(fields: [candidateId], references: [userId], onDelete: Restrict)
  scenarioId           String
  scenario             Scenario         @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  /// Public version pins are rechecked before each write; the scenario ID anchors immutable content.
  scenarioVersion      Int
  rubricVersion        Int
  selectionsJson       Json             @default("{}")
  writtenJustification String           @default("")
  /// Compare-and-increment prevents stale tabs overwriting saved or submitted work.
  revision             Int              @default(1)
  savedAt              DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
  /// Non-null only when the current saved content was submitted; no final score/credential state.
  submittedAt          DateTime?        @db.Timestamptz(3)

  @@id([candidateId, scenarioId])
  @@index([scenarioId])
}

/// Records participation, not mastery or eligibility. Kept separate from self-marked reference lessons.
model PracticeProgress {
  candidateId      String
  candidate        CandidateProfile @relation(fields: [candidateId], references: [userId], onDelete: Restrict)
  competency       Competency
  level            LearningLevel
  submissionCount  Int              @default(1)
  firstCompletedAt DateTime         @default(now()) @db.Timestamptz(3)
  lastCompletedAt  DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  @@id([candidateId, competency, level])
}

/// All revisions and banks of the same underlying task share this family identity.
model ScenarioFamily {
  id        String             @id @default(cuid())
  code      String             @unique
  scenarios Scenario[]
  exposures ScenarioExposure[]
}

/// Publish a new version instead of changing a rubric already pinned to an assessment.
model Rubric {
  id           String         @id @default(cuid())
  code         String
  version      Int
  demoLabel    String         @default("DEMO - SYNTHETIC")
  /// Written rubric: alignment 0..2, evidence 0..2, clarity 0..1. Never regex-grade prose.
  criteriaJson Json
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  scenarios    Scenario[]
  gradingJobs  AiGradingJob[]

  @@unique([code, version])
}

model Scenario {
  id                      String                 @id @default(cuid())
  familyId                String
  family                  ScenarioFamily         @relation(fields: [familyId], references: [id], onDelete: Restrict)
  version                 Int
  track                   Track
  competencies            Competency[]
  difficulty              LearningLevel
  bank                    ScenarioBank
  status                  PublicationStatus      @default(DRAFT)
  title                   String
  demoLabel               String                 @default("DEMO - SYNTHETIC")
  isSyntheticFixture      Boolean                @default(true)
  prompt                  String
  responseA               String
  responseB               String
  evidenceJson            Json
  rubricId                String
  rubric                  Rubric                 @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  /// Server-only deterministic key. Always select learner-facing fields explicitly in future APIs/RSCs.
  answerKeyJson           Json
  /// Server-only, human-approved alternatives receive full credit; do not exact-match nuanced prose.
  allowedAlternativesJson Json                   @default("[]")
  /// Immediate feedback in practice only; capstone coaching and explanations stay locked.
  expertExplanation       String
  publishedAt             DateTime?              @db.Timestamptz(3)
  createdAt               DateTime               @default(now()) @db.Timestamptz(3)
  responses               SubmissionResponse[]
  practiceDrafts          PracticeDraft[]
  capstonePools           CapstoneScenarioPool[]

  @@unique([familyId, version, bank])
  @@index([track, bank, difficulty, status])
}

/// One ledger row per family, across versions/banks. Practice retries remain unlimited;
/// future capstone selection excludes previously exposed families.
model ScenarioExposure {
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [userId], onDelete: Restrict)
  familyId    String
  family      ScenarioFamily   @relation(fields: [familyId], references: [id], onDelete: Restrict)
  firstSeenAt DateTime         @default(now()) @db.Timestamptz(3)

  @@id([candidateId, familyId])
  @@index([familyId])
}

model AssessmentAttempt {
  id                            String               @id @default(cuid())
  candidateId                   String
  candidate                     CandidateProfile     @relation(fields: [candidateId], references: [userId], onDelete: Restrict)
  mode                          AssessmentMode
  track                         Track
  level                         LearningLevel
  status                        AttemptStatus        @default(IN_PROGRESS)
  isSyntheticFixture            Boolean              @default(true)
  demoLabel                     String               @default("DEMO - SYNTHETIC")
  independentWorkPolicyVersion  String?
  independentWorkAcknowledgedAt DateTime?            @db.Timestamptz(3)
  /// Nullable for pre-blueprint history only; new capstones must pin both immutable versions.
  capstoneBlueprintId           String?
  capstoneBlueprint             CapstoneBlueprint?   @relation(fields: [capstoneBlueprintId], references: [id], onDelete: Restrict)
  scoringPolicyId               String?
  scoringPolicy                 ScoringPolicy?       @relation(fields: [scoringPolicyId], references: [id], onDelete: Restrict)
  /// All lifecycle timestamps are written/enforced by the server, never client clocks.
  startedAt                     DateTime             @default(now()) @db.Timestamptz(3)
  /// Required for capstone; diagnostic is untimed. No client-side timer authority.
  expiresAt                     DateTime?            @db.Timestamptz(3)
  /// Time the server observed expiry; cooldown starts at expiresAt, not a delayed page visit.
  expiredAt                     DateTime?            @db.Timestamptz(3)
  submittedAt                   DateTime?            @db.Timestamptz(3)
  finalizedAt                   DateTime?            @db.Timestamptz(3)
  /// Snapshot of the profile multiplier used when the server computes expiresAt.
  appliedTimeMultiplier         Float                @default(1)
  /// Deterministic subtotal: judgment 40 + rubric 30 + verification 25 = 95.
  deterministicScore            Decimal?             @db.Decimal(5, 2)
  /// Three independently dual-judged 0..5 justifications normalize to 5 points total.
  writtenScore                  Decimal?             @db.Decimal(3, 2)
  finalScore                    Decimal?             @db.Decimal(5, 2)
  /// NULL until finalized; only a finalized capstone score >= 85 can be a pass.
  passed                        Boolean?
  scratchpadNotes               String               @default("")
  /// Autosave uses compare-and-increment against this server-owned version.
  revision                      Int                  @default(0)
  /// A unique final-submission idempotency token; one submission per attempt.
  submissionKey                 String?              @unique
  responses                     SubmissionResponse[]
  reviewCase                    ReviewCase?
  credential                    Credential?
  appeals                       AssessmentAppeal[]

  @@index([candidateId, mode, startedAt])
  @@index([status])
  @@index([capstoneBlueprintId])
  @@index([scoringPolicyId])
}

/// Append-only versioned scoring contract. SQL guards preserve the 40/30/25/5 weights and finalized 85% standard.
model ScoringPolicy {
  id                         String              @id @default(cuid())
  code                       String
  version                    Int
  evaluationJudgmentPoints   Int                 @default(40)
  rubricApplicationPoints    Int                 @default(30)
  factualVerificationPoints  Int                 @default(25)
  writtenJustificationPoints Int                 @default(5)
  passingThreshold           Decimal             @default(85) @db.Decimal(5, 2)
  isSyntheticFixture         Boolean             @default(true)
  demoLabel                  String              @default("DEMO - SYNTHETIC")
  createdAt                  DateTime            @default(now()) @db.Timestamptz(3)
  blueprints                 CapstoneBlueprint[]
  attempts                   AssessmentAttempt[]

  @@unique([code, version])
}

/// Publish only after all six slots and their isolated pools exist; published definitions and policy text are immutable.
model CapstoneBlueprint {
  id                           String                  @id @default(cuid())
  code                         String
  version                      Int
  title                        String
  track                        Track                   @default(GENERALIST)
  status                       PublicationStatus       @default(DRAFT)
  scoringPolicyId              String
  scoringPolicy                ScoringPolicy           @relation(fields: [scoringPolicyId], references: [id], onDelete: Restrict)
  baseDurationSeconds          Int                     @default(3600)
  retakeCooldownHours          Int                     @default(48)
  /// Participation in each G-area is required, regardless of score/learning level; optional activities never substitute.
  requireGeneralistPractice    Boolean                 @default(true)
  independentWorkPolicyVersion String
  independentWorkRulesJson     Json
  isSyntheticFixture           Boolean                 @default(true)
  demoLabel                    String                  @default("DEMO - SYNTHETIC")
  publishedAt                  DateTime?               @db.Timestamptz(3)
  createdAt                    DateTime                @default(now()) @db.Timestamptz(3)
  slots                        CapstoneBlueprintSlot[]
  attempts                     AssessmentAttempt[]

  @@unique([code, version])
  @@index([scoringPolicyId])
}

/// One fixed G1–G6 slot per form; exactly three slots designate written prompts for later review.
model CapstoneBlueprintSlot {
  blueprintId   String
  blueprint     CapstoneBlueprint      @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  position      Int
  competency    Competency
  writtenPrompt String?
  pool          CapstoneScenarioPool[]

  @@id([blueprintId, position])
  @@unique([blueprintId, competency])
}

/// Immutable membership pins scenario and rubric versions; selection excludes the learner's entire family-exposure ledger.
model CapstoneScenarioPool {
  blueprintId String
  position    Int
  slot        CapstoneBlueprintSlot @relation(fields: [blueprintId, position], references: [blueprintId, position], onDelete: Restrict)
  scenarioId  String
  scenario    Scenario              @relation(fields: [scenarioId], references: [id], onDelete: Restrict)

  @@id([blueprintId, position, scenarioId])
  @@unique([blueprintId, scenarioId])
  @@index([scenarioId])
}

model SubmissionResponse {
  id                   String            @id @default(cuid())
  attemptId            String
  attempt              AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  /// Scenario version and its rubric remain pinned through the immutable scenario ID.
  scenarioId           String
  scenario             Scenario          @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  position             Int
  /// Structured judgment/rubric/verification selections; never trusted scores.
  selectionsJson       Json              @default("{}")
  writtenJustification String?
  revision             Int               @default(0)
  savedAt              DateTime          @updatedAt @db.Timestamptz(3)
  gradingJobs          AiGradingJob[]

  @@unique([attemptId, scenarioId])
  @@unique([attemptId, position])
  @@index([scenarioId])
}

model AiGradingJob {
  id                 String             @id @default(cuid())
  responseId         String
  response           SubmissionResponse @relation(fields: [responseId], references: [id], onDelete: Restrict)
  /// PostgreSQL CHECK allows exactly 1 or 2; uniqueness isolates the two judge slots.
  judgeSlot          Int
  modelVersion       String
  promptVersion      String
  rubricId           String
  rubric             Rubric             @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  isSyntheticFixture Boolean            @default(true)
  demoLabel          String             @default("DEMO - SYNTHETIC")
  status             JudgeJobStatus     @default(QUEUED)
  retryCount         Int                @default(0)
  latencyMs          Int?
  /// Compare each criterion exactly, not just totals; disagreement requires owner review.
  alignment          Int?
  evidence           Int?
  clarity            Int?
  rationale          String?
  /// Store a safe failure category, not raw provider bodies or candidate secrets.
  errorCode          String?
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  completedAt        DateTime?          @db.Timestamptz(3)
  /// Frozen written rubric and untrusted text, plus allowlisted synthetic context and posture for live dispatch.
  inputSnapshotJson  Json?
  inputHash          String?
  /// Stable internal dispatch identity. One call per job; ambiguous failures require owner review.
  dispatchKey        String?            @unique
  claimToken         String?
  startedAt          DateTime?          @db.Timestamptz(3)

  @@unique([responseId, judgeSlot])
  @@index([status, createdAt])
  @@index([rubricId])
}

/// Append-only terminal receipts retain raw votes and pinned metadata even after operational job maintenance.
/// Identifiers deliberately have no foreign keys: deleting an operational row cannot erase grading history.
model AiGradingReceipt {
  id                 String         @id @default(cuid())
  jobId              String         @unique
  attemptId          String
  responseId         String
  judgeSlot          Int
  rubricId           String
  modelVersion       String
  promptVersion      String
  inputHash          String
  dispatchKey        String         @unique
  isSyntheticFixture Boolean
  demoLabel          String         @default("DEMO - SYNTHETIC")
  status             JudgeJobStatus
  /// A validated vote and allowlisted provider telemetry. Older receipts may contain bounded invalid adapter votes.
  rawVoteJson        Json?
  errorCode          String?
  retryCount         Int            @default(0)
  latencyMs          Int
  startedAt          DateTime       @db.Timestamptz(3)
  completedAt        DateTime       @db.Timestamptz(3)

  @@index([attemptId])
}

model ReviewCase {
  id                      String                @id @default(cuid())
  attemptId               String                @unique
  attempt                 AssessmentAttempt     @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  triggerReason           ReviewTriggerReason
  /// All routing causes are retained; ALPHA_SIGN_OFF is mandatory even when both judges agree.
  gradingReasons          ReviewTriggerReason[] @default([])
  status                  ReviewStatus          @default(PENDING)
  ownerId                 String?
  owner                   User?                 @relation("ReviewOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  /// Future server/UI must withhold AI scores/rationales until Michael saves this rubric-first assessment.
  ownerPreliminaryJson    Json?
  ownerPreliminarySavedAt DateTime?             @db.Timestamptz(3)
  finalScoresJson         Json?
  /// Required and nonblank when finalized, even if both judges agree (alpha sign-off gate).
  rationale               String?
  appealReason            String?
  appealedAt              DateTime?             @db.Timestamptz(3)
  createdAt               DateTime              @default(now()) @db.Timestamptz(3)
  finalizedAt             DateTime?             @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([ownerId])
}

model Credential {
  id                 String                  @id @default(cuid())
  /// One credential per finalized passing attempt makes issuance idempotent.
  attemptId          String                  @unique
  attempt            AssessmentAttempt       @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  /// Random UUIDv4, never a sequential or candidate-derived public identifier.
  publicSlug         String                  @unique @default(uuid()) @db.Uuid
  isDemo             Boolean                 @default(true)
  demoLabel          String                  @default("DEMO - SYNTHETIC")
  status             CredentialStatus        @default(ACTIVE)
  publicShareEnabled Boolean                 @default(false)
  /// Only these enum-approved fields may ever be projected into public verification.
  publicFields       CredentialPublicField[] @default([TRACK, ISSUED_AT, COMPETENCIES])
  publicDisplayName  String?
  track              Track
  competencies       Competency[]
  issuedAt           DateTime                @default(now()) @db.Timestamptz(3)
  suspendedAt        DateTime?               @db.Timestamptz(3)
  revokedAt          DateTime?               @db.Timestamptz(3)
}

/// Original attempts/reviews remain immutable; resolved appeals are audited result revisions.
/// A partial SQL unique index permits only one OPEN appeal per attempt, including concurrent requests.
model AssessmentAppeal {
  id                         String            @id @default(cuid())
  publicReference            String            @unique @db.Uuid
  attemptId                  String
  attempt                    AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  reason                     String
  evidenceNote               String
  status                     AppealStatus      @default(OPEN)
  submittedAt                DateTime          @default(now()) @db.Timestamptz(3)
  beforeScoreJson            Json
  disposition                AppealDisposition?
  dispositionRationale       String?
  resolvedById               String?
  resolvedAt                 DateTime?         @db.Timestamptz(3)
  resolutionScoresJson       Json?
  resolvedDeterministicScore Decimal?          @db.Decimal(5, 2)
  resolvedWrittenScore       Decimal?          @db.Decimal(3, 2)
  resolvedFinalScore         Decimal?          @db.Decimal(5, 2)

  @@index([attemptId, status])
  @@index([status, submittedAt])
}

model OpportunityListing {
  id                 String              @id @default(cuid())
  code               String              @unique
  title              String
  organization       String
  url                String              @unique
  linkType           OpportunityLinkType
  partnershipStatus  PartnershipStatus   @default(NO_FORMAL_PARTNERSHIP)
  disclosure         String              @default("NO_FORMAL_PARTNERSHIP — independently curated public link; no endorsement or placement agreement.")
  limitationsNote    String
  sourceLabel        String              @default("Source requires owner verification")
  sourceUrl          String              @default("https://example.org/")
  eligibilityNote    String              @default("Check current eligibility and screening with the source.")
  active             Boolean             @default(true)
  /// Referral permission and any referrer benefit must be explicit; Stage A fixture permission is simulated.
  referralDisclosure String?
  referralPermissionNote String?
  /// Last actual public-link verification, not the time a seed happens to run.
  lastVerifiedAt     DateTime            @db.Timestamptz(3)
  isSyntheticFixture Boolean             @default(true)
  demoLabel          String              @default("DEMO - SYNTHETIC")
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
}

/// Append-only: migration triggers reject UPDATE, DELETE and TRUNCATE, including raw SQL.
/// Audit only allowlisted operational metadata; never secrets, diagnoses or candidate prose.
model AuditEvent {
  id           String   @id @default(cuid())
  eventKey     String   @unique
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  action       String
  targetType   String
  targetId     String?
  metadataJson Json     @default("{}")
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
}
