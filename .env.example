# Use your Neon PostgreSQL connection string; never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require"
# Unpooled Neon endpoint for migrations; points to the same database/branch as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Set a randomly generated secret of at least 32 characters in your root .env.
AUTH_SECRET=""
# Stage A must default to synthetic grading only.
ENABLE_LIVE_ZDR_GRADING="false"

# Auth links use a trusted origin, never a request Host header. Use your HTTPS app URL on Vercel.
AUTH_APP_ORIGIN="http://127.0.0.1:3000"
# auto: no key/sender -> account/owner-only Closed Alpha preview; both configured -> email.
# preview may be selected explicitly for the invite-only alpha. email fails closed without both values.
AUTH_EMAIL_MODE="auto"
RESEND_API_KEY=""
# Configure an email address verified by your email provider before enabling email delivery.
AUTH_EMAIL_FROM=""

# DEMO - SYNTHETIC: seed-only secrets, 8–128 characters each. Set distinct random values.
# Used only to provision missing hashes; reseeding does not reset existing passwords/status.
# User: demo-username
DEMO_MARCUS_PASSWORD=""
DEMO_ELENA_PASSWORD=""
DEMO_MICHAEL_PASSWORD=""
